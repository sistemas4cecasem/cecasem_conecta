# Configuración de prueba local. No usar estas credenciales en producción.

# Puertos
WEB_PORT=3000
APP_PORT=3000

# Sesiones y primer acceso (segundos)
SESSION_TTL_SECONDS=28800
FIRST_ACCESS_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=14400
# false para HTTP local/LAN; true detrás de HTTPS.
SESSION_COOKIE_SECURE=false

# TablePlus y PostgreSQL. Los valores DB_* son la única fuente de credenciales.
# DB_HOST es el host que escribirás en TablePlus; Compose limita la DB a este equipo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cecasem_conecta
DB_USER=cecasem
DB_PASSWORD=development_only
DB_ADMIN_PASSWORD=bootstrap_development_only

# Archivos privados
FILE_STORAGE_ROOT=/app/storage/private
FILE_MAX_BYTES=20971520

# Traducción opcional; completar la URL y la clave solo si se habilita.
TRANSLATION_ENABLED=false
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=10000
