# Solo desarrollo/LAN de prueba: sustituir las contraseñas antes de uso real.
WEB_PORT=8080
APP_PORT=3000
SESSION_TTL_SECONDS=28800
FIRST_ACCESS_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=14400
# HTTP local/LAN: false. Acceso HTTPS: true.
SESSION_COOKIE_SECURE=false
POSTGRES_DB=cecasem_conecta
# Cuenta de aplicación; no usar postgres como nombre.
POSTGRES_USER=cecasem
POSTGRES_PASSWORD=development_only
# Credencial distinta para inicialización/administración del contenedor DB.
POSTGRES_ADMIN_PASSWORD=bootstrap_development_only
# Debe coincidir con DB, usuario y contraseña anteriores. Host interno: db.
# Codificar caracteres especiales del usuario/contraseña como componentes URL.
DATABASE_URL=postgresql://cecasem:development_only@db:5432/cecasem_conecta

# Ruta privada dentro del contenedor; el volumen dedicado se monta aquí.
FILE_STORAGE_ROOT=/app/storage/private
FILE_MAX_BYTES=20971520

# Traducción opcional. El proveedor recibe únicamente el cuerpo original y los idiomas.
TRANSLATION_ENABLED=false
LIBRETRANSLATE_URL=http://translator:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=10000
