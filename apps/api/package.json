{
  "name": "@cecasem-conecta/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "yarn prisma:generate && nest start --watch",
    "build": "yarn prisma:generate && nest build",
    "lint": "yarn prisma:generate && eslint .",
    "typecheck": "yarn prisma:generate && tsc --noEmit",
    "test": "yarn prisma:generate && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "yarn prisma:generate && NODE_OPTIONS=--experimental-vm-modules jest --runInBand src",
    "test:e2e": "yarn prisma:generate && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns=e2e-spec",
    "bootstrap:admin": "yarn build && node dist/bootstrap-admin.js",
    "demo:prepare": "node ../../scripts/demo/prepare-demo.mjs",
    "test:integration": "yarn prisma:generate && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config jest.integration.config.mjs",
    "start": "yarn prisma:generate && nest start",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie": "2.0.1",
    "exceljs": "^4.4.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
