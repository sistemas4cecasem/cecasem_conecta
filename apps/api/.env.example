# API ejecutada en el host junto a la Web de Docker publicada en el puerto 3000.
NODE_ENV=development
APP_PORT=3001
SESSION_TTL_SECONDS=28800
FIRST_ACCESS_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=14400
# false para HTTP local/LAN; true exclusivamente cuando el acceso utiliza HTTPS.
SESSION_COOKIE_SECURE=false
# Ejemplo local no sensible: sustituir por la conexión de desarrollo real.
# La cuenta de aplicación no debe requerir privilegios de superusuario.
DATABASE_URL=postgresql://cecasem:development_only@localhost:5432/cecasem_conecta

# Opcional: ruta ABSOLUTA privada. Sin definir usa storage/private bajo el cwd de API.
# FILE_STORAGE_ROOT=/absolute/private/storage
FILE_MAX_BYTES=20971520

# Traducción opcional. El proveedor recibe únicamente el cuerpo original y los idiomas.
TRANSLATION_ENABLED=false
LIBRETRANSLATE_URL=http://translator:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=10000
