generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Referral {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCommunicationId String @db.Uuid
  sourceCommunication Communication @relation(fields: [sourceCommunicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String @db.Uuid
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  recommendedName String? @db.VarChar(300)
  recommendedRole String? @db.VarChar(300)
  organizationNameSnapshot String? @db.VarChar(300)
  mediumType ContactType?
  mediumValue String? @db.VarChar(2048)
  notes String? @db.VarChar(5000)
  personId String? @db.Uuid
  person Person? @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organizationId String? @db.Uuid
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactMethodId String? @db.Uuid
  contactMethod ContactMethod? @relation(fields: [contactMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestKey String @db.Uuid
  requestFingerprint String @db.VarChar(64)
  auditEvent AuditEvent?
  @@unique([createdByUserId, requestKey])
  @@index([sourceCommunicationId, createdAt, id])
  @@index([personId])
  @@index([organizationId])
  @@index([contactMethodId])
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  BOARD
  RESEARCH
  PLANNING
}

enum AuditAction {
  DATA_IMPORT_BATCH_APPLIED
  DATA_IMPORT_BATCH_FAILED
  REMINDER_INTERVAL_UPDATED
  MEETING_RECORDED
  REFERRAL_CREATED
  OPPORTUNITY_CREATED
  OPPORTUNITY_UPDATED
  OPPORTUNITY_STATUS_CHANGED
  OPPORTUNITY_DISCARDED
  OPPORTUNITY_FINISHED
  FILES_ATTACHED
  COMMUNICATION_INVALIDATED
  RECEIVED_COMMUNICATION_REGISTERED
  SENT_COMMUNICATION_REGISTERED
  CONTACT_RESTRICTION_CREATED
  CONTACT_RESTRICTION_LIFTED
  PROCESS_CREATED
  PROCESS_STATE_CHANGED
  PROCESS_CLOSED
  PROCESS_REOPENED
  CONTACT_INTENT_CREATED
  CONTACT_INTENT_CANCELLED
  CONTACT_INTENT_CONVERTED
  DUPLICATE_CONSOLIDATED
  VERIFICATION_SETTINGS_CHANGED
  PASSWORD_RESET_ISSUED
  PASSWORD_RESET_REGENERATED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_REVOKED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  MAILBOX_ASSIGNED
  MAILBOX_REMOVED
  ORGANIZATION_UPDATED
  ORGANIZATION_STATUS_CHANGED
  CATEGORY_UPDATED
  CATEGORY_STATUS_CHANGED
  PERSON_UPDATED
  PERSON_STATUS_CHANGED
  PERSON_RELATION_UPDATED
  PERSON_RELATION_ENDED
  CONTACT_METHOD_UPDATED
  CONTACT_METHOD_CONDITION_CHANGED
  CONTACT_ASSOCIATION_CREATED
  CONTACT_ASSOCIATION_UPDATED
  CONTACT_ASSOCIATION_ENDED
  CONTACT_ASSOCIATION_STATUS_CHANGED
}

enum DataImportBatchStatus {
  ANALYZED
  IMPORTED
  FAILED
}

enum DataImportRecordKind {
  ORGANIZATION
  PERSON
  CONTACT
  HISTORICAL_RECORD
}

enum DataImportRowStatus {
  READY
  NEEDS_REVIEW
  INVALID
  IMPORTED
  IGNORED
}

enum ImportedHistoryKind {
  SENT
  RECEIVED
  OTHER
  UNKNOWN
}

enum ContactType {
  EMAIL
  PHONE
  LINKEDIN
  FORM
  WEB
  OTHER
}

enum ContactCondition {
  USABLE
  UNUSABLE
}

model User {
  requestedTranslations CommunicationTranslation[]
  createdMeetings Meeting[] @relation("MeetingCreator")
  meetingParticipations MeetingParticipant[] @relation("MeetingInternalUser")
  addedMeetingParticipants MeetingParticipant[] @relation("MeetingParticipantAuthor")
  meetingAgreements MeetingAgreement[]
  meetingEvents MeetingEvent[]
  createdReferrals Referral[]
  notifications Notification[]
  createdOpportunities Opportunity[]
  opportunityEvents OpportunityEvent[]
  fileUploads FileUpload[]
  communicationAmendments CommunicationAmendment[]
  internalNotes InternalNote[]
  registeredCommunications Communication[]
  registeredContactRestrictions ContactRestriction[] @relation("RestrictionRegistrar")
  liftedContactRestrictions ContactRestriction[] @relation("RestrictionLifter")
  createdProcesses RelationshipProcess[] @relation("ProcessCreator")
  closedProcesses RelationshipProcess[] @relation("ProcessCloser")
  processParticipations ProcessParticipant[]
  processEvents RelationshipProcessEvent[]
  authoredContactIntents ContactIntent[] @relation("IntentAuthor")
  cancelledContactIntents ContactIntent[] @relation("IntentCanceller")
  resolvedDuplicateCandidates DuplicateCandidate[]
  initiatedDataImports DataImportBatch[]
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  givenNames    String             @db.VarChar(150)
  familyNames   String             @db.VarChar(150)
  username      String             @unique @db.VarChar(64)
  email         String             @unique @db.VarChar(254)
  role          UserRole
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  deactivatedAt DateTime?          @db.Timestamptz(3)
  passwordHash  String?
  emailAccounts UserEmailAccount[]
  sessions      UserSession[]
  firstAccessTokens FirstAccessToken[] @relation("FirstAccessRecipient")
  issuedFirstAccessTokens FirstAccessToken[] @relation("FirstAccessIssuer")
  passwordResetTokens PasswordResetToken[] @relation("PasswordResetRecipient")
  issuedPasswordResetTokens PasswordResetToken[] @relation("PasswordResetIssuer")
  verifications Verification[]
  performedAuditEvents AuditEvent[] @relation("AuditActor")
  receivedAuditEvents AuditEvent[] @relation("AuditTarget")
  directoryChanges DirectoryChange[]
}

model PasswordResetToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  createdByUserId String    @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  usedAt          DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  user            User      @relation("PasswordResetRecipient", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User      @relation("PasswordResetIssuer", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvents     AuditEvent[]

  @@index([userId])
  @@index([createdByUserId])
}

model AuditEvent {
  dataImportBatchId String? @unique @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  previousReminderIntervalDays Int?
  newReminderIntervalDays Int?
  meetingEventId String? @unique @db.Uuid
  meetingEvent MeetingEvent? @relation(fields: [meetingEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referralId String? @unique @db.Uuid
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  opportunityEventId String? @unique @db.Uuid
  opportunityEvent OpportunityEvent? @relation(fields: [opportunityEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fileUploadId String? @unique @db.Uuid
  fileUpload FileUpload? @relation(fields: [fileUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([communicationId, action])
  processId String? @db.Uuid
  process RelationshipProcess? @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  communicationId String? @db.Uuid
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactRestrictionId String? @db.Uuid
  contactRestriction ContactRestriction? @relation(fields: [contactRestrictionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([contactRestrictionId, createdAt])
  processEventId String? @unique @db.Uuid
  processEvent RelationshipProcessEvent? @relation(fields: [processEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactIntentId String? @db.Uuid
  contactIntent ContactIntent? @relation(fields: [contactIntentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([contactIntentId, createdAt])
  duplicateCandidateId String? @db.Uuid
  principalOrganizationId String? @db.Uuid
  duplicateOrganizationId String? @db.Uuid
  principalPersonId String? @db.Uuid
  duplicatePersonId String? @db.Uuid
  duplicateCandidate DuplicateCandidate? @relation(fields:[duplicateCandidateId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  principalOrganization Organization? @relation("AuditPrincipalOrganization",fields:[principalOrganizationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  duplicateOrganization Organization? @relation("AuditDuplicateOrganization",fields:[duplicateOrganizationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  principalPerson Person? @relation("AuditPrincipalPerson",fields:[principalPersonId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  duplicatePerson Person? @relation("AuditDuplicatePerson",fields:[duplicatePersonId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([duplicateCandidateId])
  @@index([principalOrganizationId,createdAt])
  @@index([duplicateOrganizationId,createdAt])
  @@index([principalPersonId,createdAt])
  @@index([duplicatePersonId,createdAt])
  previousPersonalVerificationMonths Int?
  newPersonalVerificationMonths Int?
  previousInstitutionalVerificationMonths Int?
  newInstitutionalVerificationMonths Int?
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action               AuditAction
  actorUserId          String?   @db.Uuid
  targetUserId         String?   @db.Uuid
  passwordResetTokenId String?   @db.Uuid
  previousRole         UserRole?
  newRole              UserRole?
  emailAccountId       String?   @db.Uuid
  organizationId       String?   @db.Uuid
  categoryId           String?   @db.Uuid
  operationId          String?   @db.Uuid
  personId             String?   @db.Uuid
  personRelationId     String?   @db.Uuid
  contactMethodId      String?   @db.Uuid
  personContactId      String?   @db.Uuid
  organizationContactId String? @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  actor                User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  target               User?     @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  passwordResetToken   PasswordResetToken? @relation(fields: [passwordResetTokenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  emailAccount         EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  person               Person? @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  personRelation       PersonOrganizationRelation? @relation(fields: [personRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactMethod        ContactMethod? @relation(fields: [contactMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  personContact        PersonContact? @relation(fields: [personContactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organizationContact OrganizationContact? @relation(fields: [organizationContactId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorUserId])
  @@index([passwordResetTokenId])
  @@index([emailAccountId])
  @@index([organizationId, createdAt])
  @@index([categoryId, createdAt])
  @@index([personId, createdAt])
  @@index([personRelationId, createdAt])
  @@index([contactMethodId, createdAt])
  @@index([personContactId, createdAt])
  @@index([organizationContactId, createdAt])
}

model Organization {
  dataImportBatchId String? @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  importedRows DataImportRow[] @relation("ImportedRowOrganization")
  importedHistoryRecords ImportedHistoricalRecord[]
  referrals Referral[]
  opportunityLinks OpportunityOrganization[]
  contactRestrictions ContactRestriction[]
  relationshipProcesses RelationshipProcess[]
  contactIntents ContactIntent[]
  duplicateOfId String? @db.Uuid
  duplicateOf Organization? @relation("OrganizationDuplicates",fields:[duplicateOfId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  consolidatedRecords Organization[] @relation("OrganizationDuplicates")
  candidatesA DuplicateCandidate[] @relation("CandidateOrganizationA")
  candidatesB DuplicateCandidate[] @relation("CandidateOrganizationB")
  resolvedCandidates DuplicateCandidate[] @relation("CandidatePrincipalOrganization")
  principalAuditEvents AuditEvent[] @relation("AuditPrincipalOrganization")
  duplicateAuditEvents AuditEvent[] @relation("AuditDuplicateOrganization")
  @@index([duplicateOfId])
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String @db.VarChar(250)
  country         String? @db.VarChar(150)
  alias           String? @db.VarChar(150)
  description     String? @db.VarChar(5000)
  officialWebsite String? @db.VarChar(2048)
  isActive        Boolean @default(true)
  version         Int @default(1)
  parentId        String? @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  lastVerifiedAt  DateTime? @db.Timestamptz(3)
  parent          Organization? @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children        Organization[] @relation("OrganizationHierarchy")
  categories      OrganizationCategory[]
  changes         DirectoryChange[]
  auditEvents     AuditEvent[]
  personRelations PersonOrganizationRelation[]
  contacts        OrganizationContact[]

  @@index([parentId, name, id])
  @@index([isActive, name, id])
  verifications Verification[]
}

model Category {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String @db.VarChar(150)
  normalizedName String @unique @db.VarChar(150)
  isActive       Boolean @default(true)
  version        Int @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  organizations  OrganizationCategory[]
  changes        DirectoryChange[]
  auditEvents    AuditEvent[]

  @@index([isActive, name, id])
}

model OrganizationCategory {
  organizationId String @db.Uuid
  categoryId     String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, categoryId])
  @@index([categoryId])
}

model DirectoryChange {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String? @db.Uuid
  categoryId     String? @db.Uuid
  personId       String? @db.Uuid
  personRelationId String? @db.Uuid
  contactMethodId String? @db.Uuid
  personContactId String? @db.Uuid
  organizationContactId String? @db.Uuid
  operationId    String @db.Uuid
  field          String @db.VarChar(32)
  previousValue  Json
  newValue       Json
  referenceSnapshot Json?
  actorUserId    String @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  person         Person? @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  personRelation PersonOrganizationRelation? @relation(fields: [personRelationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactMethod ContactMethod? @relation(fields: [contactMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  personContact PersonContact? @relation(fields: [personContactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organizationContact OrganizationContact? @relation(fields: [organizationContactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([categoryId, createdAt, id])
  @@index([personId, createdAt, id])
  @@index([personRelationId, createdAt, id])
  @@index([contactMethodId, createdAt, id])
  @@index([personContactId, createdAt, id])
  @@index([organizationContactId, createdAt, id])
  @@index([actorUserId])
  @@unique([operationId, field])
}

model Person {
  dataImportBatchId String? @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  importedRows DataImportRow[] @relation("ImportedRowPerson")
  importedHistoryRecords ImportedHistoricalRecord[]
  meetingParticipations MeetingParticipant[]
  referrals Referral[]
  contactRestrictions ContactRestriction[]
  relationshipProcesses RelationshipProcess[]
  contactIntents ContactIntent[]
  duplicateOfId String? @db.Uuid
  duplicateOf Person? @relation("PersonDuplicates",fields:[duplicateOfId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  consolidatedRecords Person[] @relation("PersonDuplicates")
  candidatesA DuplicateCandidate[] @relation("CandidatePersonA")
  candidatesB DuplicateCandidate[] @relation("CandidatePersonB")
  resolvedCandidates DuplicateCandidate[] @relation("CandidatePrincipalPerson")
  principalAuditEvents AuditEvent[] @relation("AuditPrincipalPerson")
  duplicateAuditEvents AuditEvent[] @relation("AuditDuplicatePerson")
  @@index([duplicateOfId])
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName    String @db.VarChar(250)
  givenNames     String? @db.VarChar(150)
  familyNames    String? @db.VarChar(150)
  isActive       Boolean @default(true)
  version        Int @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  lastVerifiedAt DateTime? @db.Timestamptz(3)
  relations      PersonOrganizationRelation[]
  contacts       PersonContact[]
  changes        DirectoryChange[]
  auditEvents    AuditEvent[]

  @@index([isActive, displayName, id])
  verifications Verification[]
}

model PersonOrganizationRelation {
  dataImportBatchId String? @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  reconciliationSources DuplicateReconciliation[] @relation("ReconciliationSourceRelation")
  reconciliationTargets DuplicateReconciliation[] @relation("ReconciliationTargetRelation")
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId          String @db.Uuid
  organizationId    String @db.Uuid
  positionTitle     String? @db.VarChar(250)
  area              String? @db.VarChar(250)
  lastVerifiedAt    DateTime? @db.Timestamptz(3)
  isCurrent         Boolean @default(true)
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  sourceDescription String? @db.VarChar(1000)
  sourceUrl         String? @db.VarChar(2048)
  notes             String? @db.VarChar(5000)
  version           Int @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  person            Person @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changes           DirectoryChange[]
  auditEvents       AuditEvent[]

  @@index([personId, isCurrent, createdAt, id])
  @@index([organizationId, isCurrent, createdAt, id])
  verifications Verification[]
}

model ContactMethod {
  dataImportBatchId String? @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  importedRows DataImportRow[] @relation("ImportedRowContactMethod")
  referrals Referral[]
  valueVersion Int @default(1)
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type ContactType
  value String @db.VarChar(2048)
  normalizedValue String? @db.VarChar(254)
  label String? @db.VarChar(150)
  condition ContactCondition @default(USABLE)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  people PersonContact[]
  organizations OrganizationContact[]
  changes DirectoryChange[]
  auditEvents AuditEvent[]

  // Unicidad exclusiva de EMAIL mediante índice parcial SQL versionado.
  @@index([type, createdAt, id])
}

model PersonContact {
  dataImportBatchId String? @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  importedRows DataImportRow[] @relation("ImportedRowPersonContact")
  reconciliationSources DuplicateReconciliation[] @relation("ReconciliationSourcePersonContact")
  reconciliationTargets DuplicateReconciliation[] @relation("ReconciliationTargetPersonContact")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId String @db.Uuid
  contactMethodId String @db.Uuid
  sourceDescription String? @db.VarChar(1000)
  sourceUrl String? @db.VarChar(2048)
  notes String? @db.VarChar(5000)
  isActive Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  lastVerifiedAt DateTime? @db.Timestamptz(3)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactMethod ContactMethod @relation(fields: [contactMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changes DirectoryChange[]
  auditEvents AuditEvent[]

  @@unique([personId, contactMethodId])
  @@index([personId, isActive, createdAt, id])
  @@index([contactMethodId, createdAt, id])
  verifications Verification[]
}

model OrganizationContact {
  dataImportBatchId String? @db.Uuid
  dataImportBatch DataImportBatch? @relation(fields:[dataImportBatchId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  importedRows DataImportRow[] @relation("ImportedRowOrganizationContact")
  reconciliationSources DuplicateReconciliation[] @relation("ReconciliationSourceOrganizationContact")
  reconciliationTargets DuplicateReconciliation[] @relation("ReconciliationTargetOrganizationContact")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  contactMethodId String @db.Uuid
  sourceDescription String? @db.VarChar(1000)
  sourceUrl String? @db.VarChar(2048)
  notes String? @db.VarChar(5000)
  isActive Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  lastVerifiedAt DateTime? @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactMethod ContactMethod @relation(fields: [contactMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changes DirectoryChange[]
  auditEvents AuditEvent[]

  @@unique([organizationId, contactMethodId])
  @@index([organizationId, isActive, createdAt, id])
  @@index([contactMethodId, createdAt, id])
  verifications Verification[]
}

model FirstAccessToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  createdByUserId String?   @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  usedAt          DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  user            User      @relation("FirstAccessRecipient", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User?     @relation("FirstAccessIssuer", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([createdByUserId])
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
