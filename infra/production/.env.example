# Plantilla sin credenciales. Genera infra/production/.env con el asistente local.
# SESSION_COOKIE_SECURE debe elegirse explícitamente según el terminador TLS.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
APP_PORT=3000
SESSION_COOKIE_SECURE=
POSTGRES_DB=cecasem_conecta
POSTGRES_USER=cecasem
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
DATABASE_URL=
FILE_STORAGE_ROOT=/app/storage/private
FILE_MAX_BYTES=20971520
SESSION_TTL_SECONDS=28800
FIRST_ACCESS_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=14400
TRANSLATION_ENABLED=false
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=10000
